---
import SiteLayout from "../layouts/SiteLayout.astro";
import { sitePath } from "../site-path";
import "../styles/redesign.css";
import ProcessPipeline from "../components/ProcessPipeline.astro";
import CaseDiagram from "../components/CaseDiagram.astro";

const journeyChapters = [
  {
    id: "access", kicker: "01 · Access", title: "Access & Account", watermark: "Access",
    description: "New readers can create and verify an account. Returning readers can sign in or recover their password.",
    rows: [
      { label: "New user", screens: [
        ["welcome", "Welcome", "Introduction to VietJusticIA with options to continue or sign in."],
        ["sign-up", "Create an account", "Account form for a name, phone number, email and password."],
        ["verify-account", "Verify phone", "Six-digit verification code fields and a resend option."],
      ] },
      { label: "Returning / recovery", screens: [
        ["sign-in", "Welcome back", "Sign-in form with a password recovery link."],
        ["reset-password", "Reset password", "Email field to request a password reset link."],
        ["new-password", "Create new password", "New password and confirmation fields with requirements."],
      ] },
    ],
  },
  {
    id: "assistant", kicker: "02 · Assistant", title: "Legal Assistant", watermark: "Assistant",
    description: "The assistant cites the law in its answers. Readers can revisit a conversation and inspect the article it cites.",
    rows: [
      { label: "Ask & verify", screens: [
        ["new-conversation", "Ask a legal question", "New conversation with suggested legal topics and a question field."],
        ["contract-answer", "Answer with inline sources", "A contract question and an answer with links to the cited statutes."],
      ] },
      { label: "Revisit & audit", screens: [
        ["history", "Saved conversation history", "Past conversations grouped into pinned, recently opened and sent to lawyer."],
        ["statute-reader", "Inspect source statute", "Labor Code reader with article navigation and the cited passage."],
      ] },
    ],
  },
  {
    id: "lookup", kicker: "03 · Lookup", title: "Law & Procedure Lookup", watermark: "Lookup",
    description: "Statutes and administrative procedures share an entry point. Each has filters and detail views suited to the information it contains.",
    rows: [
      { label: "Laws", screens: [
        ["legal-documents", "Browse legal documents", "Legal document cards showing titles, numbers and validity status."],
        ["document-filters", "Filter by authority & status", "Filters for validity, legal domain, hierarchy and effective period."],
      ] },
      { label: "Procedures", screens: [
        ["procedures", "Administrative procedures", "Procedure cards showing the responsible agency, fee and processing time."],
        ["procedure-filters", "Filter procedures", "Filters for submission method, handling agency and expected processing time."],
        ["procedure-schema", "Step-by-step schema", "Labor dispute mediation timeline and required document templates."],
      ] },
    ],
  },
  {
    id: "handoff", kicker: "04 · Handover", title: "Specialist Handover", watermark: "Handover",
    description: "A reviewed brief carries the question, sources and conversation into a consultation. Readers can track requests and compare verified specialists.",
    rows: [
      { label: "Connect", screens: [
        ["requests", "Consultation requests", "Open and closed consultation requests showing their stages and latest activity."],
        ["specialist", "Matched legal specialist", "Verified lawyer profile with practice areas, reviews and consultation fee."],
      ] },
      { label: "Collaborate", screens: [
        ["handover", "Case context handover", "Case brief with the attached conversation and suggested specialists."],
        ["lawyer-chat", "1-on-1 lawyer chat", "Conversation with a lawyer and the original case brief pinned above it."],
        ["directory", "Verified directory", "Specialist directory with practice areas, locations and consultation fees."],
      ] },
    ],
  },
];
---

<SiteLayout
  title={"VietJusticIA redesign · Ace Nguyen"}
  description={"Ace Nguyen’s solo mobile redesign of VietJusticIA connects cited legal answers, document lookup and consultations with a lawyer."}
  bodyClass="case-study-page redesign"
>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&amp;display=swap">
  </Fragment>
  <script src="../scripts/redesign.js"></script>
  <script src="../scripts/continuous-journey.js"></script>
  <main id="main">
    <section class="case-intro wrap redesign-intro" aria-labelledby="case-title">
      <div>
        <p class="eyebrow">Solo product design · Mobile app</p>
        <h1 id="case-title">VietJusticIA<span class="blue">.</span></h1>
        <p class="case-deck">From a legal question to a lawyer.</p>
        <p class="redesign-intro-copy">A redesign for people in Vietnam who need to check a legal answer, read its source and decide what to do next.</p>
        <a class="text-link" href="#flow">Follow the contract journey</a>
      </div>
      <img class="cover-board" src={sitePath("assets/work/redesign/cover-devices.webp")} width="968" height="740" alt="Two phones show the VietJusticIA legal assistant and a lawyer’s specialist profile." fetchpriority="high">
    </section>
    <section class="wrap case-stats" aria-label="VietJusticIA at a glance">
      <dl class="case-metrics">
        <div>
          <dt>To complete basic tasks in the original app</dt>
          <dd>4-5 <small>taps</small></dd>
        </div>
        <div>
          <dt>Always visible in the redesigned bottom navigation</dt>
          <dd>5 <small>destinations</small></dd>
        </div>
        <div>
          <dt>Built for the redesign</dt>
          <dd>49 <small>component families</small></dd>
        </div>
      </dl>
    </section>
    <nav class="phase-nav" id="contents" aria-labelledby="contents-title">
      <div class="wrap">
        <div class="contents-head"><h2 id="contents-title">Contents</h2><p class="eyebrow">12 chapters <span aria-hidden="true">/</span> 4 phases</p></div>
        <div class="contents-grid">
          <div>
            <h3 class="eyebrow">Understand</h3>
            <ul>
              <li><a href="#brief"><span aria-hidden="true">01</span>Project overview</a></li>
              <li><a href="#audit"><span aria-hidden="true">02</span>Interface audit</a></li>
            </ul>
          </div>
          <div>
            <h3 class="eyebrow">Structure</h3>
            <ul>
              <li><a href="#structure"><span aria-hidden="true">03</span>Sitemap</a></li>
              <li><a href="#flow"><span aria-hidden="true">04</span>User flows</a></li>
              <li><a href="#wireframes"><span aria-hidden="true">05</span>Wireframes</a></li>
            </ul>
          </div>
          <div>
            <h3 class="eyebrow">Design</h3>
            <ul>
              <li><a href="#system"><span aria-hidden="true">06</span>Visual system</a></li>
              <li><a href="#access"><span aria-hidden="true">07</span>Access &amp; account</a></li>
              <li><a href="#assistant"><span aria-hidden="true">08</span>Legal Assistant</a></li>
              <li><a href="#lookup"><span aria-hidden="true">09</span>Law &amp; Procedure Lookup</a></li>
              <li><a href="#handoff"><span aria-hidden="true">10</span>Specialist Handover</a></li>
            </ul>
          </div>
          <div>
            <h3 class="eyebrow">Deliver</h3>
            <ul>
              <li><a href="#device-mockup"><span aria-hidden="true">11</span>Device mockup</a></li>
              <li><a href="#outcome"><span aria-hidden="true">12</span>Design outcome</a></li>
            </ul>
          </div>
        </div>
      </div>
    </nav>
    <section class="editorial-band"><div class="editorial-section wrap briefing" id="brief">
      <div><p class="eyebrow chapter-tag"><span>01</span>Project overview</p><h2>Where do you start with a legal question?</h2></div>
      <div><p class="vj-lede">I built the original VietJusticIA for my computing degree. For this solo redesign, I followed one question across the app. What happens when a graduate is asked to hand over their original diploma for a first job?</p>
      <p>A reader might find what they need in the Labor Code. If they want a lawyer’s opinion, they should be able to take the question, the cited article and the conversation with them.</p>
      <dl class="credits"><div><dt>Designed for</dt><dd>Citizens and small-business owners in Vietnam</dd></div><div><dt>My role</dt><dd>Solo product designer</dd></div><div><dt>Scope</dt><dd>Interface audit, information architecture, wireframes, visual identity and mobile UI</dd></div></dl></div>
    </div></section>
    <section class="editorial-band"><div class="editorial-section wrap" id="audit">
      <div class="vj-heading"><div><p class="eyebrow chapter-tag"><span>02</span>Interface audit</p><h2>The menu hid the next step.</h2></div><p>In the original app, basic tasks took four to five taps. I traced the paths to a document and a lawyer, then looked at what happened when a reader hit an error.</p></div>
      <h3 class="audit-label">Original app</h3>
      <div class="audit-gallery">
        <figure>
          <a class="evidence" data-enlarge href={sitePath("assets/work/audit-menu.webp")} aria-label="Enlarge navigation menu">
            <img src={sitePath("assets/work/audit-menu.webp")} width="439" height="848" alt="Navigation menu with Vietnamese entries for legal lookup and contacting a lawyer." loading="lazy">
          </a>
          <figcaption><h4>Hidden destinations</h4><p>Document lookup and lawyer search sat behind the full-screen menu.</p></figcaption>
        </figure>
        <figure>
          <a class="evidence" data-enlarge href={sitePath("assets/work/audit-reader.webp")} aria-label="Enlarge legal document reader">
            <img src={sitePath("assets/work/audit-reader.webp")} width="440" height="886" alt="Vietnamese resolution with two columns of official headings above the article text." loading="lazy">
          </a>
          <figcaption><h4>Dense document layouts</h4><p>Two columns squeezed official headings onto a phone screen.</p></figcaption>
        </figure>
        <figure>
          <a class="evidence" data-enlarge href={sitePath("assets/work/audit-verification.webp")} aria-label="Enlarge verification screen">
            <img src={sitePath("assets/work/audit-verification.webp")} width="440" height="848" alt="Invalid verification code alert displayed over the code entry dialog." loading="lazy">
          </a>
          <figcaption><h4>Stacked dialogs</h4><p>An invalid code opened an alert over the verification dialog.</p></figcaption>
        </figure>
      </div>
      <h3 class="audit-label">Redesign</h3>
      <div class="audit-gallery">
        <figure><a class="evidence" data-enlarge href={sitePath("assets/work/redesign/vectors/legal-documents.svg")} aria-label="Enlarge redesigned lookup screen"><img src={sitePath("assets/work/redesign/legal-documents.webp")} width="700" height="1517" alt="Redesigned lookup screen with five bottom navigation destinations" loading="lazy"></a><figcaption><h4>Persistent navigation</h4><p>Lookup and Lawyers each have a permanent place in the bottom bar.</p></figcaption></figure>
        <figure><a class="evidence" data-enlarge href={sitePath("assets/work/redesign/vectors/statute-reader.svg")} aria-label="Enlarge single-column statute reader"><img src={sitePath("assets/work/redesign/statute-reader.webp")} width="700" height="1516" alt="Single-column statute reader with article navigation" loading="lazy"></a><figcaption><h4>Single-column reader</h4><p>Readers can follow the statute in one column and jump directly to an article.</p></figcaption></figure>
        <figure><a class="evidence" data-enlarge href={sitePath("assets/work/redesign/vectors/verify-account.svg")} aria-label="Enlarge dedicated verification screen"><img src={sitePath("assets/work/redesign/verify-account.webp")} width="700" height="1516" alt="Dedicated verification screen with code entry and resend action" loading="lazy"></a><figcaption><h4>Dedicated verification screen</h4><p>The code entry and resend action have a screen of their own.</p></figcaption></figure>
      </div>
    </div></section>
    <section class="editorial-band"><div class="editorial-section wrap" id="structure">
      <div class="vj-heading"><div><p class="eyebrow chapter-tag"><span>03</span>Sitemap</p><h2>Five destinations in view.</h2></div><p>I moved the library and lawyer directory out of the full-screen menu. Lookup, Lawyers, AI Assistant, Requests and Profile now share a persistent bottom bar.</p></div>
      <p class="design-target"><strong>Design target for core actions</strong> · ≤2 taps</p>
      <section class="editorial-artifact">
        <p class="eyebrow">Information architecture</p>
        <h3>Product sitemap</h3>
        <CaseDiagram title="Product sitemap" src="assets/work/redesign/vectors/sitemap.svg"
          description="Product sitemap showing account access and the five persistent destinations, with document details, chat history, case tracking and profile settings."
          width={1440} height={636} minWidth={1080} />
      </section>
    </div></section>
    <section class="editorial-band"><div class="editorial-section wrap journey-section" id="flow">
      <div class="vj-heading"><div><p class="eyebrow chapter-tag"><span>04</span>User flows</p><h2>A first job offer raises a question.</h2></div><p>A graduate is asked to hand over their original diploma. Here’s how that question travels through the prototype.</p></div>
      <ProcessPipeline label="Contract question and consultation journey" steps={[
        {
          label: "Ask", title: "Ask about the contract",
          description: "The graduate describes the clause in their own words. The assistant cites the relevant Labor Code article.",
          screen: { image: "assets/work/redesign/contract-answer.webp", vector: "assets/work/redesign/vectors/contract-answer.svg", alt: "Contract question and cited assistant answer.", height: 1516 },
        },
        {
          label: "Verify", title: "Check the source",
          description: "The citation opens the statute reader. If the article answers the question, the graduate can stop here and revisit the conversation later.",
          screen: { image: "assets/work/redesign/statute-reader.webp", vector: "assets/work/redesign/vectors/statute-reader.svg", alt: "Article in the Labor Code reader.", height: 1516 },
        },
        {
          label: "Handover", title: "Review the handover",
          description: "For a second opinion, the graduate checks the summary, transcript and citations, compares three specialists and sends the brief.",
          screen: { image: "assets/work/redesign/handover.webp", vector: "assets/work/redesign/vectors/handover.svg", alt: "Case handover with specialist matches and attached citations.", height: 1514 },
        },
      ]} />
      <p class="direct-route">Someone ready to speak to a lawyer can open the directory directly. Once a lawyer accepts, the brief stays pinned in their chat.</p>
      <section class="editorial-artifact">
        <p class="eyebrow">Interaction map</p>
        <h3>Full user flow</h3>
        <CaseDiagram title="User flow" src="assets/work/redesign/vectors/user-flow.svg"
          description="End-to-end flow diagram with branches for saving the answer, requesting a lawyer, and choosing another specialist if the request is declined."
          width={1440} height={1176} minWidth={1080} />
      </section>
    </div></section>
    <section class="editorial-section wrap" id="wireframes" aria-labelledby="wireframes-title">
      <h2 class="wireframes-title" id="wireframes-title">Wireframes</h2>
      <CaseDiagram title="Wireframe board" src="assets/work/redesign/vectors/wireframes.svg"
        description="Grayscale mobile wireframes for account access, legal lookup, chat and lawyer consultations."
        width={1440} height={2131} minWidth={980} />
    </section>
    <section class="editorial-band"><div class="editorial-section wrap" id="system">
      <div class="vj-heading"><div><p class="eyebrow chapter-tag"><span>06</span>Visual system</p><h2>A visual language for reading the law.</h2></div>
        <p>Across a statute, a case brief and a lawyer’s profile, readers encounter the same colors, type scale and controls.</p></div>

      <section class="system-part" id="color-palette" aria-labelledby="palette-heading">
        <h3 id="palette-heading">Color palette</h3>
        <dl class="color-collage">
          <div class="swatch-justice"><dt>Justice Blue</dt><dd><code>#1E40AF</code></dd></div>
          <div class="swatch-gold"><dt>Warm Gold</dt><dd><code>#D4A72C</code></dd></div>
          <div class="swatch-teal"><dt>Deep Teal</dt><dd><code>#0F766E</code></dd></div>
        </dl>
      </section>

      <section class="system-part" id="typography" aria-labelledby="type-heading">
        <h3 id="type-heading">Typography</h3>
        <div class="type-sheet">
          <div class="type-intro">
            <span class="type-ghost" aria-hidden="true">Be Vietnam Pro</span>
            <h4 id="typeface-name">Be Vietnam Pro</h4>
          </div>
          <table class="type-scale" aria-labelledby="typeface-name">
            <thead class="sr-only"><tr><th scope="col">Style</th><th scope="col">Size / line height</th></tr></thead>
            <tbody>
              <tr><th scope="row" class="type-display">Display</th><td>24 / 32 px</td></tr>
              <tr><th scope="row" class="type-title">Title</th><td>20 / 28 px</td></tr>
              <tr><th scope="row" class="type-body">Body</th><td>16 / 24 px</td></tr>
              <tr><th scope="row" class="type-small">Body small</th><td>14 / 20 px</td></tr>
              <tr><th scope="row" class="type-caption">Caption</th><td>12 / 16 px</td></tr>
              <tr><th scope="row" class="type-micro">Micro</th><td>10 / 14 px</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="system-part" id="components" aria-labelledby="components-heading">
        <h3 id="components-heading">Components</h3>
        <div class="component-layout">
          <div><h4>Reusable controls</h4><p>Account forms use 44 px fields. In legal lookup, the same underline marks the active tab for documents and procedures. Green and amber communicate status across the app.</p>
            <dl class="library-counts"><div><dt>Source components</dt><dd>80</dd></div></dl></div>
          <a class="component-plate plate" href={sitePath("assets/work/redesign/controls.webp")} data-enlarge aria-label="Enlarge reusable controls"><img src={sitePath("assets/work/redesign/controls.webp")} width="700" height="628" loading="lazy" decoding="async" alt="Email field, primary and secondary buttons, and the Legal Docs and Procedures tabs."></a>
        </div>
      </section>
    </div></section>
    <section class="editorial-section wrap journey-continuous" id="continuous-journey" aria-labelledby="journey-heading">
      <svg class="journey-line-overlay" aria-hidden="true" focusable="false">
        <path class="journey-path-progress" />
        <circle class="journey-path-tip" r="5" fill="#1d4ed8" />
      </svg>
      <div class="vj-heading journey-intro" id="screens">
        <h2 id="journey-heading">Final Mobile UI</h2>
        <p>Follow the redesign from account setup through legal research and a consultation.</p>
      </div>
      <nav class="screen-index" aria-label="Journey chapters">
        {journeyChapters.map(({ id, title }) => <a href={`#${id}`}>{title}</a>)}
      </nav>
      {journeyChapters.map(({ id, kicker, title, watermark, description, rows }) => (
        <section class="journey-chapter" id={id} aria-labelledby={`${id}-heading`}>
          <header class="journey-chapter-header">
            <span class="journey-watermark" aria-hidden="true">{watermark}</span>
            <div class="journey-chapter-copy">
              <p class="eyebrow">{kicker}</p>
              <h3 id={`${id}-heading`}>{title}</h3>
              <p>{description}</p>
            </div>
          </header>
          <div class="journey-rows">
            {rows.map(({ label, screens }, rowIndex) => (
              <div class="journey-row-group">
                <p class="eyebrow journey-row-label">{label}</p>
                <div class="journey-row" data-journey-columns={screens.length} style={`--journey-columns: ${screens.length}`}>
                  {screens.map(([file, name, alt], column) => (
                    <div class="journey-screen" style={`--journey-stagger: ${column * 44}px`}>
                      <figure class="journey-step" data-journey-step data-journey-first={file === "welcome" ? "" : undefined}>
                        <img class="journey-phone" src={sitePath(`assets/work/redesign/vectors/${file}.svg`)}
                          alt={alt} width="393" height="852" loading="lazy" decoding="async">
                        <figcaption><span class="eyebrow journey-step-index">{String((rowIndex ? rows[0].screens.length : 0) + column + 1).padStart(2, "0")} ·</span> {name}</figcaption>
                      </figure>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </section>
    <section class="editorial-band" id="device-mockup" aria-labelledby="mockup-title"><div class="editorial-section wrap vj-split">
      <div><p class="eyebrow chapter-tag"><span>11</span>Device mockup</p><h2 id="mockup-title">VietJusticIA on mobile.</h2></div>
      <a class="plate" href={sitePath("assets/work/hero.webp")} data-enlarge aria-label="Enlarge the mobile mockup"><img src={sitePath("assets/work/hero.webp")} width="1500" height="1050" loading="lazy" decoding="async" alt="Hands holding a phone with the finished contract review open in VietJusticIA."></a>
    </div></section>
    <section class="editorial-band vj-outcome" id="outcome" aria-labelledby="outcome-title"><div class="editorial-section wrap vj-split">
      <div><p class="eyebrow chapter-tag"><span>12</span>Design outcome</p><h2 id="outcome-title">One case from question to consultation.</h2></div>
      <div><p>The graduate can leave with the cited law or send a reviewed brief to a lawyer. When the consultation begins, the lawyer already has the question and the sources behind it.</p>
      <a class="text-link" href="https://www.behance.net/gallery/258814687/VietJusticIA-AI-Legal-Tech-Mobile-App-Redesign">View the original Behance presentation</a></div>
    </div></section>
  </main>
  <dialog class="art-viewer" aria-label="Enlarged project artwork"><div class="viewer-bar"><span id="viewer-title"></span><button type="button" autofocus>Close</button></div><div class="viewer-image"><img alt=""><object type="image/svg+xml" hidden></object></div><a class="viewer-original" href="#">Open image at full size</a></dialog>
  <footer class="footer wrap"><a href={sitePath("vietjusticia-platform.html")}>Explore the original platform</a><a href="#top">Back to top</a></footer>
</SiteLayout>
